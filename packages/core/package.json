{
  "name": "crawlette-core",
  "version": "0.1.0",
  "description": "Browser-native crawl processing: DOM cleaning, markdown generation, content filters, structured extraction and deep-crawl strategies. No server, no Python -- the portable engine behind the Crawlette extension.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/picomatch": "^4.0.3",
    "@types/turndown": "^5.0.6",
    "linkedom": "^0.18.11",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "crawler",
    "scraping",
    "markdown",
    "llm",
    "extraction",
    "readability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammadKhallaf/crawlette.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.1",
    "picomatch": "^4.0.7",
    "tinyqueue": "^3.0.0",
    "tldts": "^7.4.11",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
